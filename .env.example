# Server-side only: Vercel Blob token used by POST /api/upload (cover images).
# In production this is set automatically by Vercel; locally it's optional.
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token

# Public (inlined into the client bundle): Audius Discovery API key for the
# trending track catalog (components/vurafy/audius.ts). A fallback key is
# hardcoded in that file, so this is optional.
NEXT_PUBLIC_AUDIUS_API_KEY=your_audius_api_key

# Public: WalletConnect Cloud projectId (wallet connect on mobile).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
