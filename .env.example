# Robinhood Chain Configuration
NEXT_PUBLIC_RPC_URL=https://robinhood-rpc.publicnode.com
NEXT_PUBLIC_CHAIN_ID=4663

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_ID=your_walletconnect_project_id

# Blockscout API (optional, for enhanced features)
BLOCKSCOUT_API_KEY=your_blockscout_api_key

# Polymarket Builder Program (legacy, can be removed)
POLYMARKET_API_KEY=your_api_key
POLYMARKET_SECRET=your_secret
POLYMARKET_PASSPHRASE=your_passphrase

# Trading bot (legacy, can be removed)
BOT_PRIVATE_KEY=your_bot_wallet_private_key
BOT_ENABLED=true
BOT_LONGSHOT=true

# Telegram bot credentials (server-side only, optional).
# NEVER expose these to the client or put them in NEXT_PUBLIC_* variables.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_or_group_id

# Privy (app secret stays on server, never in client code)
PRIVY_APP_SECRET=your_privy_app_secret
